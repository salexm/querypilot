# QueryPilot environment template
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is ignored by git. Never commit real keys or passwords.
# Every value below is a placeholder.

# -----------------------------------------------------------------------------
# PostgreSQL server (admin account, used only for setup and migrations)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port published on 127.0.0.1. Change it if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=querypilot_admin
POSTGRES_PASSWORD=change-me-admin-password

# -----------------------------------------------------------------------------
# Analytics database (the data users ask questions about)
# -----------------------------------------------------------------------------
ANALYTICS_DB_NAME=analytics

# Role used for all LLM-generated SQL. It has SELECT access only.
ANALYTICS_READONLY_USER=querypilot_readonly
ANALYTICS_READONLY_PASSWORD=change-me-readonly-password

# -----------------------------------------------------------------------------
# App database (query history and traces)
# -----------------------------------------------------------------------------
APP_DB_NAME=querypilot_app
APP_DB_USER=querypilot_app
APP_DB_PASSWORD=change-me-app-password

# -----------------------------------------------------------------------------
# Query execution limits
# -----------------------------------------------------------------------------
QUERY_TIMEOUT_MS=10000
QUERY_MAX_ROWS=1000

# -----------------------------------------------------------------------------
# Public demo limits, which protect your LLM credits
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=5
DAILY_QUERY_LIMIT=200
# Proxies in front of the API that append to X-Forwarded-For. 0 means none.
TRUSTED_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Only anthropic is supported so far
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=your-api-key-here
# One of: low, medium, high
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=60

# Send SQL errors and empty results back to the LLM, up to this many retries
SELF_CORRECTION_ENABLED=true
SELF_CORRECTION_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# API and frontend
# -----------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Port published on 127.0.0.1. Change it if 8000 is already in use on your machine.
API_HOST_PORT=8000
# Port published on 127.0.0.1. If you change it, add the new origin to CORS_ORIGINS.
WEB_HOST_PORT=5173

# Vite exposes VITE_* values in browser code, so never put secrets in them
VITE_API_BASE_URL=http://localhost:8000
