# Copy this to .env.neon at the repo root and fill it in. .env.neon is ignored by git.
# Every value below is a placeholder.

# From the Neon connection details. Use the direct host, not the -pooler one.
POSTGRES_HOST=your-project.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your-neon-owner-password
ANALYTICS_DB_NAME=neondb
PGSSLMODE=require

# Created by the seed. Neon needs a long, random password.
SETUP_READONLY_ROLE=1
ANALYTICS_READONLY_USER=querypilot_readonly
ANALYTICS_READONLY_PASSWORD=choose-a-long-random-password
QUERY_TIMEOUT_MS=10000
